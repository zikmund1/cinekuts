---
import ReviewCard from './ReviewCard.astro';

interface Item {
  href: string;
  title: string;
  poster: string;
  meta: string;
  score?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
<section class="review-rail" id="latest-reviews" data-review-rail>
  <div class="review-rail-head">
    <h2 class="two-tone">
      Latest reviews<br />
      <span class="echo">Watched and scored</span>
    </h2>
    <div class="review-rail-nav">
      <button type="button" class="rail-btn" data-rail-prev aria-label="Previous reviews">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10.778 2.444 5.223 8l5.555 5.556" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="rail-btn" data-rail-next aria-label="Next reviews">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M5.222 2.444 10.777 8l-5.555 5.556" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <a class="btn btn-secondary" href="/reviews">Show all reviews</a>
    </div>
  </div>
  <div class="review-rail-bleed">
    <div class="review-rail-track" data-rail-track>
      {items.map((item) => (
        <ReviewCard {...item} class="review-rail-card" />
      ))}
    </div>
  </div>
</section>

<script>
  function setupReviewRails() {
    document.querySelectorAll<HTMLElement>('[data-review-rail]').forEach((section) => {
      const track = section.querySelector<HTMLElement>('[data-rail-track]');
      const prev = section.querySelector<HTMLButtonElement>('[data-rail-prev]');
      const next = section.querySelector<HTMLButtonElement>('[data-rail-next]');
      if (!track || !prev || !next) return;

      const step = () => {
        const card = track.querySelector('.review-rail-card');
        return card ? card.getBoundingClientRect().width + 12 : 252;
      };

      const sync = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        prev.disabled = track.scrollLeft <= 0;
        next.disabled = track.scrollLeft >= max;
      };

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }

  setupReviewRails();
</script>
