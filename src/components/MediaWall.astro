---
interface Tile {
  title: string;
  image: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;

function fill(source: Tile[], min: number) {
  const row: Tile[] = [];
  if (source.length === 0) return row;
  while (row.length < min) row.push(...source);
  return row.slice(0, min);
}

function hash(value: string) {
  return [...value].reduce((total, character) => ((total * 31) + character.charCodeAt(0)) >>> 0, 7);
}

function mix(source: Tile[], salt: string) {
  return [...source].sort((a, b) => hash(`${salt}:${a.title}`) - hash(`${salt}:${b.title}`));
}

const perRow = Math.max(10, tiles.length);
const rows = [
  { className: "media-wall-row media-wall-row-a", items: fill(mix(tiles, "a"), perRow) },
  { className: "media-wall-row media-wall-row-b", items: fill(mix(tiles, "b"), perRow) },
];
---

{tiles.length > 0 && (
  <div class="media-wall" aria-hidden="true">
    <div class="media-wall-track">
      {rows.map((row) => (
        <div class={row.className}>
          {[...row.items, ...row.items].map((tile, i) => (
            <div class="screen">
              <img
                class="screen-media"
                src={tile.image}
                alt=""
                loading={i < 6 ? "eager" : "lazy"}
              />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
)}
