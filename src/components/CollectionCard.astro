---
import { formatListDate, TMDB_POSTER } from '../lib/lists';

interface Props {
  href: string;
  title: string;
  tagline?: string;
  itemCount: number;
  publishDate: Date;
  posters: string[];
}

const { href, title, tagline, itemCount, publishDate, posters } = Astro.props;
const shown = posters.slice(0, 4);
const noun = itemCount === 1 ? 'title' : 'titles';
---
<a class="collection-card" href={href}>
  <div class="collection-card-posters" style={`--poster-count: ${Math.max(shown.length, 1)}`}>
    {shown.map((path) => (
      <img src={`${TMDB_POSTER}${path}`} alt="" loading="lazy" />
    ))}
  </div>
  <div class="collection-card-body">
    <h2 class="collection-card-title">{title}</h2>
    {tagline && <p class="collection-card-tagline">{tagline}</p>}
    <p class="card-meta">{itemCount} {noun} · {formatListDate(publishDate)}</p>
  </div>
</a>
