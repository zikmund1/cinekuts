---
import '@fontsource-variable/inter';
import { getCollection } from 'astro:content';
import { giveawayActive } from '../lib/publication';
import { includeSamples } from '../lib/content';
const hasGiveaway = (await getCollection('giveaways')).some(g => !g.data.sample && giveawayActive(g.data));

interface Props {
  title: string;
  description?: string;
  robots?: string;
  bare?: boolean;
}
const {
  title,
  description = "CINEKUTS — original movie & TV reviews.",
  robots,
  bare = false,
} = Astro.props;
const youtube = "https://www.youtube.com/@cinekutss";
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {(robots || includeSamples) && <meta name="robots" content={robots ?? "noindex, nofollow"} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`${title} · CINEKUTS`} />
    <meta property="og:description" content={description} />
    <title>{title} · CINEKUTS</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class={bare ? "is-status" : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {!bare && (
      <>
        <header class="site-header wrap">
          <a href="/" class="site-brand-icon" aria-label="CINEKUTS home">
            <img src="/images/cinekuts-c-icon.png" alt="" />
          </a>
          <button
            class="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-haspopup="dialog"
            aria-controls="site-menu"
            aria-expanded="false"
            data-menu-open
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
          <noscript>
            <nav class="nav-fallback" aria-label="Main navigation">
              <a href="/reviews">Reviews</a>
              <a href="/collections">Collections</a>
            </nav>
          </noscript>
        </header>

        <dialog class="site-menu" id="site-menu" aria-labelledby="site-menu-title" data-site-menu>
          <div class="site-menu-chrome wrap">
            <a href="/" class="site-brand-icon" aria-label="CINEKUTS home">
              <img src="/images/cinekuts-c-icon.png" alt="" />
            </a>
            <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
          </div>
          <div class="site-menu-content">
            <h2 class="sr-only" id="site-menu-title">Main menu</h2>
            <nav class="site-menu-nav" aria-label="Main navigation">
              <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Home</a>
              <a href="/reviews" aria-current={pathname === "/reviews" ? "page" : undefined}>Reviews</a>
              <a href="/collections" aria-current={pathname.startsWith("/collections") ? "page" : undefined}>Collections</a>
              {hasGiveaway && <a href="/#giveaway">Giveaway</a>}
              <a href={youtube} target="_blank" rel="noreferrer">YouTube <span aria-hidden="true">↗</span></a>
            </nav>
          </div>
        </dialog>
      </>
    )}
    <main class="wrap" id="main-content" tabindex="-1">
      <slot />
    </main>
    {!bare && (
      <>
        <div class="footer-mark">
          <img src="/images/CK-2026-logo-white.svg" alt="" class="footer-mark-logo" />
        </div>
        <footer class="site-footer">
          <div class="wrap foot">
            <span>
              Posters and stills from
              <a href="https://www.themoviedb.org/" target="_blank" rel="noreferrer">TMDB</a>.
              This product uses the TMDB API but is not endorsed or certified by TMDB.
            </span>
            <span>© CINEKUTS</span>
          </div>
        </footer>
      </>
    )}

    <script>
      const menu = document.querySelector<HTMLDialogElement>('[data-site-menu]');
      const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

      const closeMenu = () => {
        if (!menu?.open) return;
        menu.close();
      };

      openButton?.addEventListener('click', () => {
        if (!menu) return;
        menu.showModal();
        document.body.classList.add('menu-open');
        openButton.setAttribute('aria-expanded', 'true');
      });

      closeButton?.addEventListener('click', closeMenu);
      menu?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', closeMenu));
      menu?.addEventListener('close', () => {
        document.body.classList.remove('menu-open');
        openButton?.setAttribute('aria-expanded', 'false');
        openButton?.focus();
      });
    </script>
  </body>
</html>
